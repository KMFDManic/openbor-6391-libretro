# Source lists shared by Makefile. CORE_DIR must point at the repository root.

DEPS_DIR := $(CORE_DIR)/deps

# Engine versions linked into the core (override: make ENGINES="6391 7555")
ENGINES ?= 3711 4153 6391 7555 8025 8025_webm

INCFLAGS := \
	-I$(CORE_DIR)/common \
	-I$(DEPS_DIR)/libretro-common/include

# ---------------------------------------------------------------------------
# Common libretro layer
# ---------------------------------------------------------------------------
SOURCES_C := \
	$(CORE_DIR)/common/libretro.c \
	$(CORE_DIR)/common/detect.c \
	$(DEPS_DIR)/libretro-common/libco/libco.c

# ---------------------------------------------------------------------------
# Bundled dependencies (disable individually with SYSTEM_ZLIB=1 etc.)
# ---------------------------------------------------------------------------
ifneq ($(SYSTEM_ZLIB), 1)
INCFLAGS += -I$(DEPS_DIR)/zlib
SOURCES_C += \
	$(DEPS_DIR)/zlib/adler32.c \
	$(DEPS_DIR)/zlib/compress.c \
	$(DEPS_DIR)/zlib/crc32.c \
	$(DEPS_DIR)/zlib/deflate.c \
	$(DEPS_DIR)/zlib/infback.c \
	$(DEPS_DIR)/zlib/inffast.c \
	$(DEPS_DIR)/zlib/inflate.c \
	$(DEPS_DIR)/zlib/inftrees.c \
	$(DEPS_DIR)/zlib/trees.c \
	$(DEPS_DIR)/zlib/uncompr.c \
	$(DEPS_DIR)/zlib/zutil.c
endif

ifneq ($(SYSTEM_LIBPNG), 1)
INCFLAGS += -I$(DEPS_DIR)/libpng
SOURCES_C += \
	$(DEPS_DIR)/libpng/png.c \
	$(DEPS_DIR)/libpng/pngerror.c \
	$(DEPS_DIR)/libpng/pngget.c \
	$(DEPS_DIR)/libpng/pngmem.c \
	$(DEPS_DIR)/libpng/pngpread.c \
	$(DEPS_DIR)/libpng/pngread.c \
	$(DEPS_DIR)/libpng/pngrio.c \
	$(DEPS_DIR)/libpng/pngrtran.c \
	$(DEPS_DIR)/libpng/pngrutil.c \
	$(DEPS_DIR)/libpng/pngset.c \
	$(DEPS_DIR)/libpng/pngtrans.c \
	$(DEPS_DIR)/libpng/pngwio.c \
	$(DEPS_DIR)/libpng/pngwrite.c \
	$(DEPS_DIR)/libpng/pngwtran.c \
	$(DEPS_DIR)/libpng/pngwutil.c
endif

ifneq ($(SYSTEM_VORBIS), 1)
INCFLAGS += -I$(DEPS_DIR)/libogg/include -I$(DEPS_DIR)/libvorbis/include -I$(DEPS_DIR)/libvorbis/lib
SOURCES_C += \
	$(DEPS_DIR)/libogg/src/bitwise.c \
	$(DEPS_DIR)/libogg/src/framing.c \
	$(DEPS_DIR)/libvorbis/lib/analysis.c \
	$(DEPS_DIR)/libvorbis/lib/bitrate.c \
	$(DEPS_DIR)/libvorbis/lib/block.c \
	$(DEPS_DIR)/libvorbis/lib/codebook.c \
	$(DEPS_DIR)/libvorbis/lib/envelope.c \
	$(DEPS_DIR)/libvorbis/lib/floor0.c \
	$(DEPS_DIR)/libvorbis/lib/floor1.c \
	$(DEPS_DIR)/libvorbis/lib/info.c \
	$(DEPS_DIR)/libvorbis/lib/lookup.c \
	$(DEPS_DIR)/libvorbis/lib/lpc.c \
	$(DEPS_DIR)/libvorbis/lib/lsp.c \
	$(DEPS_DIR)/libvorbis/lib/mapping0.c \
	$(DEPS_DIR)/libvorbis/lib/mdct.c \
	$(DEPS_DIR)/libvorbis/lib/psy.c \
	$(DEPS_DIR)/libvorbis/lib/registry.c \
	$(DEPS_DIR)/libvorbis/lib/res0.c \
	$(DEPS_DIR)/libvorbis/lib/sharedbook.c \
	$(DEPS_DIR)/libvorbis/lib/smallft.c \
	$(DEPS_DIR)/libvorbis/lib/synthesis.c \
	$(DEPS_DIR)/libvorbis/lib/vorbisfile.c \
	$(DEPS_DIR)/libvorbis/lib/window.c
endif

# ---------------------------------------------------------------------------
# libvpx (VP8 decoder only, generic C) for the 8025_webm engine
# ---------------------------------------------------------------------------
ifneq ($(filter 8025_webm,$(ENGINES)),)
INCFLAGS += -I$(DEPS_DIR)/libvpx
SOURCES_C += \
	$(DEPS_DIR)/libvpx/vp8/common/alloccommon.c \
	$(DEPS_DIR)/libvpx/vp8/common/blockd.c \
	$(DEPS_DIR)/libvpx/vp8/common/dequantize.c \
	$(DEPS_DIR)/libvpx/vp8/common/entropy.c \
	$(DEPS_DIR)/libvpx/vp8/common/entropymode.c \
	$(DEPS_DIR)/libvpx/vp8/common/entropymv.c \
	$(DEPS_DIR)/libvpx/vp8/common/extend.c \
	$(DEPS_DIR)/libvpx/vp8/common/filter.c \
	$(DEPS_DIR)/libvpx/vp8/common/findnearmv.c \
	$(DEPS_DIR)/libvpx/vp8/common/generic/systemdependent.c \
	$(DEPS_DIR)/libvpx/vp8/common/idct_blk.c \
	$(DEPS_DIR)/libvpx/vp8/common/idctllm.c \
	$(DEPS_DIR)/libvpx/vp8/common/loopfilter_filters.c \
	$(DEPS_DIR)/libvpx/vp8/common/mbpitch.c \
	$(DEPS_DIR)/libvpx/vp8/common/modecont.c \
	$(DEPS_DIR)/libvpx/vp8/common/quant_common.c \
	$(DEPS_DIR)/libvpx/vp8/common/reconinter.c \
	$(DEPS_DIR)/libvpx/vp8/common/reconintra.c \
	$(DEPS_DIR)/libvpx/vp8/common/reconintra4x4.c \
	$(DEPS_DIR)/libvpx/vp8/common/rtcd.c \
	$(DEPS_DIR)/libvpx/vp8/common/setupintrarecon.c \
	$(DEPS_DIR)/libvpx/vp8/common/swapyv12buffer.c \
	$(DEPS_DIR)/libvpx/vp8/common/treecoder.c \
	$(DEPS_DIR)/libvpx/vp8/common/vp8_loopfilter.c \
	$(DEPS_DIR)/libvpx/vp8/decoder/dboolhuff.c \
	$(DEPS_DIR)/libvpx/vp8/decoder/decodeframe.c \
	$(DEPS_DIR)/libvpx/vp8/decoder/decodemv.c \
	$(DEPS_DIR)/libvpx/vp8/decoder/detokenize.c \
	$(DEPS_DIR)/libvpx/vp8/decoder/onyxd_if.c \
	$(DEPS_DIR)/libvpx/vp8/decoder/threading.c \
	$(DEPS_DIR)/libvpx/vp8/vp8_dx_iface.c \
	$(DEPS_DIR)/libvpx/vpx/src/vpx_codec.c \
	$(DEPS_DIR)/libvpx/vpx/src/vpx_decoder.c \
	$(DEPS_DIR)/libvpx/vpx/src/vpx_image.c \
	$(DEPS_DIR)/libvpx/vpx_config.c \
	$(DEPS_DIR)/libvpx/vpx_dsp/intrapred.c \
	$(DEPS_DIR)/libvpx/vpx_dsp/prob.c \
	$(DEPS_DIR)/libvpx/vpx_dsp/vpx_dsp_rtcd.c \
	$(DEPS_DIR)/libvpx/vpx_mem/vpx_mem.c \
	$(DEPS_DIR)/libvpx/vpx_scale/generic/gen_scalers.c \
	$(DEPS_DIR)/libvpx/vpx_scale/generic/vpx_scale.c \
	$(DEPS_DIR)/libvpx/vpx_scale/generic/yv12config.c \
	$(DEPS_DIR)/libvpx/vpx_scale/generic/yv12extend.c \
	$(DEPS_DIR)/libvpx/vpx_scale/vpx_scale_rtcd.c \
	$(DEPS_DIR)/libvpx/vpx_util/vpx_thread.c
endif

# ---------------------------------------------------------------------------
# Engines
# ---------------------------------------------------------------------------
# An engine "<build>_<variant>" is defined by engines/<build>/libretro/engine.mk
ENGINE_DIRS := $(sort $(foreach e,$(ENGINES),$(firstword $(subst _, ,$(e)))))
$(foreach d,$(ENGINE_DIRS),$(eval include $(CORE_DIR)/engines/$(d)/libretro/engine.mk))
